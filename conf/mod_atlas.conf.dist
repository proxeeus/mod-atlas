########################################
# DUNGEON MASTER MODULE CONFIGURATION
# (In game: Chronicler Esmadormu of the Keepers of Time, "echoes" of dungeons
#  from fractured timelines, and the Endless Timeways roguelike mode.)
########################################
#
# Procedural dungeon challenge system for AzerothCore.
# Players talk to Chronicler Esmadormu, choose difficulty / theme / dungeon,
# then get teleported to an instance populated with level-appropriate themed
# creatures.  Clear the dungeon and defeat the boss for rewards.
#

###############################################################################
# CORE SETTINGS
###############################################################################

#    Atlas.Enable
#        Master switch. While 0, nothing runs and the city NPCs are hidden.
#        Default: 0
Atlas.Enable = 0

#    Atlas.Debug
#        Default: 0
Atlas.Debug = 0

#    Atlas.NpcEntry
#        creature_template entry for the DM NPC
#        Default: 500000
Atlas.NpcEntry = 500000

###############################################################################
# DIFFICULTY TIERS
# Format: "Name,MinLevel,MaxLevel,HealthMult,DamageMult,RewardMult,MobMult"
#
# HealthMult and DamageMult multiply the role table (SCALING below). Creature
# stats already follow the level (the stock base stats of each expansion), so
# 1.0 is the tuned value at every bracket; raise or lower a bracket here to
# make it harder or easier.
###############################################################################

Atlas.Difficulty.1 = "Novice,10,19,1.0,1.0,1.0,0.5"
Atlas.Difficulty.2 = "Apprentice,20,29,1.0,1.0,1.5,0.7"
Atlas.Difficulty.3 = "Journeyman,30,44,1.0,1.0,2.0,0.85"
Atlas.Difficulty.4 = "Expert,45,59,1.0,1.0,3.0,1.0"
Atlas.Difficulty.5 = "Master,60,69,1.0,1.0,4.0,1.0"
Atlas.Difficulty.6 = "Grandmaster,70,80,1.0,1.0,6.0,1.2"
Atlas.Difficulty.7 = ""
Atlas.Difficulty.8 = ""
Atlas.Difficulty.9 = ""
Atlas.Difficulty.10 = ""

###############################################################################
# SCALING
#
# LEVEL BAND  (NEW — fixes mixed-level creature spawns)
#   Creatures are selected within EffectiveLevel ± LevelBand.
#   EffectiveLevel = solo player's level, or group average level.
#   The band is also clamped to the difficulty tier's min/max range.
#
#   Example: Level 35 player, LevelBand=3, Journeyman (30-44)
#            → creatures must be level 32-38.
#
#   Increase to 5 for more variety.  Decrease to 1-2 for strict matching.
###############################################################################

#    Atlas.Scaling.LevelBand
#        Creature selection window: effective_level ± this value
#        Default: 3
Atlas.Scaling.LevelBand = 3

# ROLE SCALING (DESIGN section 9)
#   Every run creature has a role. Its stats come from the stock base stats of
#   the run's level (creature_classlevelstats, the column of that level's
#   expansion), never from its template's own modifiers:
#     health = base x role health x tier x difficulty x party x affixes
#     melee  = base x role damage x tier x difficulty x party x affixes
#     armor  = base x role armor
#   Its spells, damage over time and heals keep their weight against its melee
#   and health: they scale by the same ratio.
#   `.atlas scaling [level] [tier] [party] [difficulty]` prints the table.
#
#    Atlas.Scaling.Role.<Role> = "health,damage,armor"
#        Roles: Trash, Elite, Rare, Miniboss, Boss, Add (summoned mid-run).
#        Tuned for a party of five at tier 1. Defaults below.
Atlas.Scaling.Role.Trash    = "1.0,1.0,1.0"
Atlas.Scaling.Role.Elite    = "2.5,1.5,1.0"
Atlas.Scaling.Role.Rare     = "6.0,2.0,1.0"
Atlas.Scaling.Role.Miniboss = "15.0,2.5,1.0"
Atlas.Scaling.Role.Boss     = "30.0,3.0,1.0"
Atlas.Scaling.Role.Add      = "0.5,0.7,1.0"

#    Atlas.Scaling.TierGrowth
#        Health and damage grow by this factor per map tier above 1 (1.075 makes
#        tier 16 about 3x). Echoes are tier 1; Endless floors use the Endless
#        depth curve instead (ROGUELIKE below).
#        Default: 1.075
Atlas.Scaling.TierGrowth = 1.075

#    Atlas.Scaling.SpellScaleMax
#        Highest factor a creature's spells can be scaled up by (a level-20
#        caster's spells brought to level 80, for example).
#        Default: 20
Atlas.Scaling.SpellScaleMax = 20

#    Party factor: the role table is tuned for a party of five, which is 1.0.
#    Smaller parties get the share of these settings relative to five:
#    with the defaults, a solo player faces 25% health and 36% damage, a party
#    of three 75% and 86%.
#
#    Atlas.Scaling.PerPlayerHealth
#        Health added per party member beyond the first.
#        Default: 0.25
Atlas.Scaling.PerPlayerHealth = 0.25

#    Atlas.Scaling.PerPlayerDamage
#        Damage added per party member beyond the first.
#        Default: 0.1
Atlas.Scaling.PerPlayerDamage = 0.1

#    Atlas.Scaling.SoloMultiplier
#        Health and damage of a solo player's creatures before the share of five.
#        Default: 0.5
Atlas.Scaling.SoloMultiplier = 0.5

###############################################################################
# VISUAL SCALE AND VARIETY
# Keeps the full creature pool. Only visual size changes; recent entries are avoided when alternatives exist.
Atlas.VisualScale.Beast = 1.00
Atlas.VisualScale.Dragonkin = 0.85
Atlas.VisualScale.Demon = 0.95
Atlas.VisualScale.Elemental = 0.90
Atlas.VisualScale.Giant = 0.70
Atlas.VisualScale.Undead = 1.00
Atlas.VisualScale.Humanoid = 1.00
Atlas.VisualScale.Mechanical = 0.90
Atlas.Variety.RecentEntries = 12

# REWARDS
###############################################################################

#    Gold amounts are in copper and are what a level 80 run earns; a lower
#    effective level earns its share (level 40 gets half). The difficulty's
#    RewardMult then applies, and the echo-cleared total is split across the
#    party (bots included).
#
#    Atlas.Rewards.BaseGold    (copper)     Default: 40000 (4g)
#        Paid for every echo mended. The Endless payout is BaseGold x depth,
#        per player.
Atlas.Rewards.BaseGold = 40000

#    Atlas.Rewards.GoldPerMob  (copper)     Default: 800 (8s)
#        Added to the echo-cleared reward for each mob killed.
Atlas.Rewards.GoldPerMob = 800

#    Atlas.Rewards.GoldPerBoss (copper)     Default: 40000 (4g)
#        Added to the echo-cleared reward for each boss killed.
Atlas.Rewards.GoldPerBoss = 40000

#    Atlas.Rewards.XPMultiplier             Default: 1.0
#        Multiplies the experience Atlas grants per kill (below max level).
Atlas.Rewards.XPMultiplier = 1.0

#    Atlas.Rewards.ItemChance  (0-100)      Default: 80
#        Chance that each player gets an item when an echo is mended.
Atlas.Rewards.ItemChance = 80

#    Atlas.Rewards.RareChance  (0-100)      Default: 40
#        When that item is not epic, the chance it is blue rather than green.
Atlas.Rewards.RareChance = 40

#    Atlas.Rewards.EpicChance  (0-100)      Default: 15
#        Chance that the echo-mended item is epic.
Atlas.Rewards.EpicChance = 15

#    Atlas.Rewards.MaxItemLevel             Default: 219
#        Highest item level any Atlas reward or drop may have. 219 matches the
#        best five-player dungeon gear (Trial of the Champion, the Icecrown
#        dungeons) and keeps raid and arena epics out. 0 = no ceiling.
Atlas.Rewards.MaxItemLevel = 219

###############################################################################
# DUNGEON SETTINGS
###############################################################################

#    Atlas.Dungeon.BossCount
#        Number of bosses (placed at furthest spawn points)
#        Default: 1
Atlas.Dungeon.BossCount = 1

#    Atlas.Dungeon.MaxCreatures
#        Most live creatures a run spawns (pack-size affixes such as Teeming
#        stop there).
#        Default: 450
Atlas.Dungeon.MaxCreatures = 450

#    Atlas.Dungeon.EliteChance  (0-100)
#        Chance for a trash mob to be elite (takes the Elite role)
#        Default: 20
Atlas.Dungeon.EliteChance = 20

#    Atlas.Dungeon.AggroRadius
#        Detection radius for spawned creatures (in yards).
#        Controls how far away a mob will detect and aggro players.
#        Default: 15.0  (reduced from standard WoW ~20-45 range)
#        Lower values (8-12) make dungeons feel less "swarm-y".
#        Creatures patrol a 5 yd radius around their spawn points.
Atlas.Dungeon.AggroRadius = 15.0

#    Atlas.Dungeon.RareSpawnChance  (0-100)
#        Chance for each pack's leader to be a rare: bigger, with 2-3 rare
#        modifiers (monster affixes of its own) and better loot.
#        Default: 5
Atlas.Dungeon.RareSpawnChance = 5

#    Atlas.Dungeon.MaxRares
#        Most rares in one run.
#        Default: 2
Atlas.Dungeon.MaxRares = 2

#    Atlas.Dungeon.Whitelist
#        Comma-separated map IDs (empty = all allowed)
Atlas.Dungeon.Whitelist = ""

#    Atlas.Dungeon.Blacklist
#        Comma-separated map IDs to exclude
Atlas.Dungeon.Blacklist = ""

###############################################################################
# THEMES
# Format: "DisplayName,CreatureType[,CreatureType...]"
# Types: 1=Beast 2=Dragonkin 3=Demon 4=Elemental 5=Giant
#        6=Undead 7=Humanoid 9=Mechanical   -1=Any (random)
###############################################################################

# Each theme is a fractured timeline: who rules the dungeon's halls there.
# These pick creatures by type. Two more come from the database (atlas_theme,
# module SQL atlas_themes.sql) and are listed first: "The timeline as it was"
# (each dungeon keeps its own inhabitants) and "A timeline the Scourge
# swallowed" (the curated Scourge pool, with pack roles). Keep the numbers
# consecutive: the list stops at the first empty one.
Atlas.Theme.1 = "A timeline where beasts reclaimed the halls,1"
Atlas.Theme.2 = "A timeline where dragonkin rule,2"
Atlas.Theme.3 = "A timeline where the Legion prevailed,3"
Atlas.Theme.4 = "A timeline torn by unbound elements,4"
Atlas.Theme.5 = "A timeline of giants,5"
Atlas.Theme.6 = "A timeline held by mortal warbands,7"
Atlas.Theme.7 = "A timeline of rogue machines,9"
Atlas.Theme.8 = "A shattered timeline (anything goes),-1"
Atlas.Theme.9 = ""
Atlas.Theme.10 = ""
Atlas.Theme.11 = ""
Atlas.Theme.12 = ""
Atlas.Theme.13 = ""
Atlas.Theme.14 = ""
Atlas.Theme.15 = ""
Atlas.Theme.16 = ""
Atlas.Theme.17 = ""
Atlas.Theme.18 = ""
Atlas.Theme.19 = ""
Atlas.Theme.20 = ""

###############################################################################
# TIMERS
###############################################################################

#    Atlas.Cooldown.Minutes (0 = no cooldown)
#        Default: 5
Atlas.Cooldown.Minutes = 5

#    Atlas.TimeLimit.Enable       Default: 0
Atlas.TimeLimit.Enable = 0

#    Atlas.TimeLimit.Minutes      Default: 30
Atlas.TimeLimit.Minutes = 30

#    Atlas.MaxConcurrentRuns      Default: 20
Atlas.MaxConcurrentRuns = 20

###############################################################################
# DEATH HANDLING
###############################################################################

#    Atlas.Death.RespawnAtStart
#        Auto-rez dead players at entrance when group leaves combat
#        Default: 1
Atlas.Death.RespawnAtStart = 1

#    Atlas.Death.MaxWipes
#        Full party wipes before auto-fail (0 = unlimited)
#        Default: 0
Atlas.Death.MaxWipes = 0

###############################################################################
# COMPLETION
###############################################################################

#    Atlas.Completion.TeleportDelay
#        Seconds after boss death before teleporting out
#        Default: 30
Atlas.Completion.TeleportDelay = 30

#    Atlas.Completion.Announcement
#        Announce challenge start to the player
#        Default: 1
Atlas.Completion.Announcement = 1

###############################################################################
# POPULATION AND CORRUPTION (DESIGN section 8)
#   A dungeon's stock spawns that stand together become a pack. Each pack is
#   native (the chosen timeline), Scourge-touched (the same, marked by the
#   plague: a dark shroud and a Necrotic touch) or Scourge, by the run's tier:
#     tiers 1-3: 90 / 10 / 0      tiers 4-6: 60 / 25 / 15
#     tiers 7-9: 35 / 30 / 35     tiers 10-12: 15 / 25 / 60
#     tiers 13-15: 0 / 15 / 85    tier 16: 0 / 0 / 100
#   Echoes are tier 1; the Endless Timeways uses its depth.
###############################################################################

#    Atlas.Population.PackRadius
#        Stock spawns within this many yards of a pack member join its pack.
#        Default: 8
Atlas.Population.PackRadius = 8

#    Atlas.Population.MaxPackSize
#        Most creatures in one pack.
#        Default: 6
Atlas.Population.MaxPackSize = 6

#    Atlas.Population.KeepSmartAI
#        Creatures driven by SmartAI (most of the Scourge pool) keep their own
#        AI and spells; everything else, and every boss, fights with the
#        module's melee AI.
#        Default: 1
Atlas.Population.KeepSmartAI = 1

#    Atlas.Corruption.ScourgeTheme
#        Theme the Scourge packs come from (atlas_theme ID).
#        Default: 51
Atlas.Corruption.ScourgeTheme = 51

#    Atlas.Corruption.TouchedAura / Atlas.Corruption.TouchedAffix
#        The plague's mark on Scourge-touched creatures: a visual-only aura
#        (10848 Shroud of Death) and one affix of their own (code, M04 Necrotic).
Atlas.Corruption.TouchedAura = 10848
Atlas.Corruption.TouchedAffix = "M04"

#    Atlas.Corruption.Shares
#        Overrides the table above: "native,touched,scourge;" for each of the six
#        corruption levels. Empty keeps the defaults.
Atlas.Corruption.Shares = ""

###############################################################################
# MAPS: ECHO SIGILS AND THE TIMEWAYS LENS (PLAN 1.4)
#   A level-80 character gets starter sigils from the Chronicler (once), and
#   places a sigil in the Timeways Lens beside her in Dalaran. A Rift in Time
#   opens beside the Lens: each member's first crossing is free (bots cross
#   with the player who uses the rift), every later crossing and every wipe
#   spends one of the run's rifts. Its master slain, a Cache of the Keepers
#   gives each player their share and new sigils.
#   GM: .atlas map give <tier> [normal|magic|rare] [codes], .atlas map list
###############################################################################

#    Atlas.Map.Enable
#        Default: 1
Atlas.Map.Enable = 1

#    Atlas.Map.MinLevel
#        Every party member must be this level to open a sigil.
#        Default: 80
Atlas.Map.MinLevel = 80

#    Atlas.Map.Portals
#        Crossings a run allows after each member's first (and wipes it
#        survives).
#        Default: 6
Atlas.Map.Portals = 6

#    Atlas.Map.Difficulty
#        Difficulty id whose reward multipliers apply to map runs (0 = the
#        hardest). Creature strength comes from the tier and the role table.
#        Default: 0
Atlas.Map.Difficulty = 0

#    Atlas.Map.EmptyTimeout
#        Minutes a run may stand empty before it is lost (1-25; instances
#        unload after 30).
#        Default: 20
Atlas.Map.EmptyTimeout = 20

#    Atlas.Map.CompletedTimeout
#        Minutes a mended run stays open for its cache (it closes sooner once
#        every player has left).
#        Default: 10
Atlas.Map.CompletedTimeout = 10

#    Atlas.Map.StarterSigils
#        Tier-1 sigils the Chronicler gives each level-80 character once.
#        Default: 3
Atlas.Map.StarterSigils = 3

#    Atlas.Map.ExcludeSources
#        Dungeons a sigil never holds (map ids). By default the Frozen Halls,
#        which ask for quests and an item level.
#        Default: "632,658,668"
Atlas.Map.ExcludeSources = "632,658,668"

#    SIGIL SUSTAIN (PLAN 1.5): a mended run's cache holds one sigil for each
#    player, a second at ExtraDropChance %; each cleared pack drops one at
#    PackDropChance % (for each player inside); an account's first clear of a
#    dungeon at a tier adds one of the next tier. Each sigil's tier shifts by
#    DropTierShift weights: one lower, the same, one higher, two higher. The
#    defaults sustain a tier about two runs in three; affix quantity raises the
#    chances. `.atlas loot [tier]` shows the ladder.

#    Atlas.Map.ExtraDropChance (%)        Default: 20
Atlas.Map.ExtraDropChance = 20

#    Atlas.Map.PackDropChance (%, decimals allowed)   Default: 1.0
Atlas.Map.PackDropChance = 1.0

#    Atlas.Map.DropTierShift              Default: "45,45,9,1"
Atlas.Map.DropTierShift = "45,45,9,1"

#    Atlas.Map.FirstClearBonus            Default: 1
Atlas.Map.FirstClearBonus = 1

#    Atlas.Map.RarityWeights
#        Normal, magic (1-2 affixes) and rare (3-4) weights for dropped sigils.
#        Default: "60,30,10"
Atlas.Map.RarityWeights = "60,30,10"

#    GEAR (PLAN 1.5): map runs give gear of their tier's item-level band (world
#    table atlas_loot_tier: 200 at tiers 1-3, 213 at 6, up to 251-264 at 16;
#    edit it and `.atlas reload`). Echoes keep the Rewards pool and its
#    MaxItemLevel ceiling. Affixes add item quantity (more gear, sigil
#    chances) and rarity (epics, magic and rare sigils), capped here (%).
#    Default: 100 / 150
Atlas.Loot.MaxQuantity = 100
Atlas.Loot.MaxRarity = 150

###############################################################################
# THE MASTER'S ARRIVAL
#   A run's master no longer waits in a room to be found: slain foes fill its
#   bar (trash, elites and rares weigh differently), and once it is full the
#   master steps out of the timeways beside the party. Echoes, maps and
#   Endless depths alike. The AtlasChronicle HUD shows the bar.
###############################################################################

#    Atlas.Boss.SummonAtForces
#        Share (%) of the run's forces to slay before the master comes.
#        0 = the old way: masters wait at their own spots.
#        Default: 75
Atlas.Boss.SummonAtForces = 75

#    Atlas.Boss.ForcesCap
#        Most forces (weighted) any run asks for, so a huge dungeon such as
#        Maraudon is not a full clear. 0 = no cap.
#        Default: 150
Atlas.Boss.ForcesCap = 150

#    Atlas.Boss.ForceWeights
#        Weight of a trash, elite and rare creature on the bar.
#        Default: "1,3,10"
Atlas.Boss.ForceWeights = "1,3,10"

#    Atlas.Boss.SummonDelay
#        Seconds between "the master comes for you" and its arrival.
#        Default: 5
Atlas.Boss.SummonDelay = 5

###############################################################################
# ATMOSPHERE (PLAN 1.6)
#   Echoes and maps get their own sky and fog: an existing client light (world
#   table atlas_atmosphere: by theme, darker as corruption rises, plus a look
#   for some affixes), sent as an override of an anchor light that covers any
#   map. No client change; leaving the map clears it.
#   GM: .atlas light <id> [anchor] to try a light, .atlas light for the run's.
###############################################################################

#    Atlas.Atmosphere.Enable              Default: 1
Atlas.Atmosphere.Enable = 1

#    Atlas.Atmosphere.Anchor / Atlas.Atmosphere.AffixAnchor
#        Global lights whose sphere covers any map, one per slot (theme look,
#        affix look). 1826 Azjol-Nerub, 2488 Icecrown Citadel; 1773 and 515
#        also work.
#        Default: 1826 / 2488
Atlas.Atmosphere.Anchor = 1826
Atlas.Atmosphere.AffixAnchor = 2488

#    Atlas.Atmosphere.FadeMs              Default: 2000
Atlas.Atmosphere.FadeMs = 2000

###############################################################################
# AFFIXES (DESIGN section 10)
#   The affixes themselves are data: world table atlas_affix (module SQL
#   atlas_affixes.sql). `.atlas affix list` shows them, `.atlas affix next`
#   forces some on a character's next run. The Endless Timeways rolls them by
#   depth (Roguelike.AffixStartTier and the second and third affix tiers).
###############################################################################

#    Atlas.Affix.BotSafeOnly
#        Only roll affixes playerbots handle with their existing behaviour.
#        Default: 1
Atlas.Affix.BotSafeOnly = 1

#    Atlas.Affix.MaxMarkers
#        Visual-only marker auras a creature shows for the affixes on it
#        (world table atlas_affix_marker), 0 = none, at most 3.
#        Default: 2
Atlas.Affix.MaxMarkers = 2

#    Atlas.Affix.RareMarker
#        The marker every rare shows first (spell id, 0 = none).
#        Default: 48019 (Arcaneform)
Atlas.Affix.RareMarker = 48019

###############################################################################
# ROGUELIKE MODE
#
# Infinite dungeon progression.  Party clears dungeons until they wipe.
# Each clear increases the tier — enemies get harder, party gets buffs.
###############################################################################

#    Atlas.Roguelike.Enable
#        Master switch for Roguelike Mode.
#        Default: 1
Atlas.Roguelike.Enable = 1

#    Atlas.Roguelike.TransitionDelay
#        Seconds between dungeon clears (loot phase / countdown).
#        Default: 30
Atlas.Roguelike.TransitionDelay = 30

# --- DIFFICULTY SCALING ---
# Per-tier multipliers. Scaling is LINEAR up to the ExponentialThreshold,
# then EXPONENTIAL beyond it.
#
# Formula (tier <= threshold):  1.0 + (tier-1) * ScalingPerTier
# Formula (tier >  threshold):  linear part + sum of ScalingPerTier * ExpFactor^(t-threshold+1)

#    Atlas.Roguelike.HpScalingPerTier
#        Health multiplier increase per tier.
#        Default: 0.10  (+10% per tier in linear zone)
Atlas.Roguelike.HpScalingPerTier = 0.10

#    Atlas.Roguelike.DmgScalingPerTier
#        Damage multiplier increase per tier.
#        Default: 0.08  (+8% per tier)
Atlas.Roguelike.DmgScalingPerTier = 0.08

#    Atlas.Roguelike.ArmorScalingPerTier
#        Armor multiplier increase per tier (linear only).
#        Default: 0.05  (+5% per tier)
Atlas.Roguelike.ArmorScalingPerTier = 0.05

#    Atlas.Roguelike.ExponentialThreshold
#        Tier at which scaling switches from linear to exponential.
#        Default: 5
Atlas.Roguelike.ExponentialThreshold = 5

#    Atlas.Roguelike.ExponentialFactor
#        Exponential growth base beyond the threshold.
#        Default: 1.15
Atlas.Roguelike.ExponentialFactor = 1.15

# --- AFFIXES ---
# Each depth from AffixStartTier rolls 1, then 2, then 3 instabilities from the
# affix table (AFFIXES section above), with the depth as the tier.

#    Atlas.Roguelike.AffixStartTier
#        First tier where an affix is applied. Set very high to disable.
#        Default: 3
Atlas.Roguelike.AffixStartTier = 3

#    Atlas.Roguelike.SecondAffixTier
#        Tier where a second simultaneous affix is added.
#        Default: 7
Atlas.Roguelike.SecondAffixTier = 7

#    Atlas.Roguelike.ThirdAffixTier
#        Tier where a third simultaneous affix is added.
#        Default: 10
Atlas.Roguelike.ThirdAffixTier = 10

# --- VENDOR NPC ---
# Spawn a friendly vendor at the dungeon entrance during roguelike runs.
# Provides repair, reagents, food, water, and ammo.
 
#    Atlas.Roguelike.VendorEnable
#        Default: 1
Atlas.Roguelike.VendorEnable = 1

# --- BUFF POOL ---
# Each dungeon clear gives the party a random buff from this pool.
# Format: "SpellId,DisplayName,Weight"
# Higher weight = more likely to be selected.
# If none configured, a default pool of well-known WoW buffs is used.

#    Atlas.Roguelike.MaxBuffs
#        Maximum number of accumulated buffs per run.
#        Default: 20
Atlas.Roguelike.MaxBuffs = 20

# Uncomment and customize to override the default buff pool:
# Atlas.Roguelike.Buff.1  = "15366,Songflower Serenade,100"
# Atlas.Roguelike.Buff.2  = "22888,Rallying Cry,80"
# Atlas.Roguelike.Buff.3  = "24425,Spirit of Zandalar,80"
# Atlas.Roguelike.Buff.4  = "16609,Warchief's Blessing,80"
# Atlas.Roguelike.Buff.5  = "23768,Fortune of Damage,60"
# Atlas.Roguelike.Buff.6  = "20217,Blessing of Kings,90"
# Atlas.Roguelike.Buff.7  = "48161,Power Word: Fortitude,100"
# Atlas.Roguelike.Buff.8  = "48469,Gift of the Wild,100"
# Atlas.Roguelike.Buff.9  = "19506,Trueshot Aura,70"
# Atlas.Roguelike.Buff.10 = "24932,Leader of the Pack,70"
